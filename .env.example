# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL="postgresql://host:5432/database"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"

# ── Auth0 (required for Google social login) ──────────────────────────────────
AUTH0_DOMAIN="your-tenant.eu.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
AUTH0_SECRET="replace-with-64-hex-chars"
APP_BASE_URL="http://localhost:3000"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=onboarding@resend.dev
APP_NAME=Football Analytics
APP_URL=http://localhost:3000

# ── Stripe (billing) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── AI Assistant (chatbot with memory) ────────────────────────────────────────
# Required: your OpenAI API key (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: override the default chat model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
