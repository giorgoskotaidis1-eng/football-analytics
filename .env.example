# Database
DATABASE_URL="******host:5432/database"

# Local app session (required by src/lib/auth.ts)
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"

# Auth0 (required for Google social login)
AUTH0_DOMAIN="your-tenant.eu.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
AUTH0_SECRET="replace-with-64-hex-chars"
APP_BASE_URL="http://localhost:3000"
