# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL="postgresql://host:5432/database"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"

# ── Auth0 (required for Google social login) ──────────────────────────────────
AUTH0_DOMAIN="your-tenant.eu.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
AUTH0_SECRET="replace-with-64-hex-chars"
APP_BASE_URL="http://localhost:3000"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=onboarding@resend.dev
APP_NAME=Football Analytics
APP_URL=http://localhost:3000

# ── Stripe (billing) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── AI Assistant (chatbot with memory) ────────────────────────────────────────
# Demo mode lets /assistant work without paid API billing.
AI_ASSISTANT_DEMO_MODE=true

# Real AI mode: set AI_ASSISTANT_DEMO_MODE=false and add your OpenAI API key.
# Never commit a real key to GitHub.
OPENAI_API_KEY=

# Optional: override the default chat model.
# Valid mini model id from OpenAI docs: gpt-5.4-mini
# Common aliases like "5 mini" and "gpt-5-mini" are normalised in code.
OPENAI_MODEL=gpt-5.4-mini
